# Copy to .env and fill in values.

# Anthropic API key for the Python analyst.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Exchange REST base URL used by the Go market-data service.
EXCHANGE_BASE_URL=https://api.binance.com

# Market-data cache TTL (set to 0s to disable caching).
MD_CACHE_TTL=30s

# Per-IP rate limit on /analyze (slowapi syntax).
AI_ANALYZE_RATE_LIMIT=10/minute

# Service log levels: debug, info, warn, error.
MD_LOG_LEVEL=info
AI_LOG_LEVEL=info
